# Salin ke .dev.vars untuk pengembangan lokal (tidak di-commit)
APP_ENV=development
DEV_ADMIN_EMAIL=admin@localhost.test

# Penilaian pengunjung (Tahap 6). Semua OPSIONAL di dev lokal:
# - tanpa SESSION_SECRET dipakai nilai bawaan dev (hanya bila APP_ENV=development)
# - tanpa TURNSTILE_SECRET pemeriksaan robot dilewati (hanya di localhost + development)
# - OTP email: tanpa penyedia, kode dikembalikan sebagai `devCode` dan terisi otomatis di form
# Produksi: semuanya WAJIB lewat `wrangler secret put` (jangan isi di berkas ini untuk produksi).
# SESSION_SECRET=ganti-dengan-string-acak-panjang
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=
# GOOGLE_CLIENT_ID=

# Email (Tahap 8): OTP booth/pengunjung dan notifikasi persetujuan.
# Jalur utama memakai binding Cloudflare Email Sending (`EMAIL` di wrangler.jsonc) + EMAIL_FROM (mis. noreply@mail.eventunimed.id).
# Tanpa EMAIL_FROM, di dev kode OTP dikembalikan sebagai `devCode` dan notifikasi dilewati; di produksi permintaan GAGAL.
# RESEND_API_KEY= # Opsional hanya bila memakai Resend sebagai cadangan
# EMAIL_FROM=LPPM Expo UNIMED <noreply@mail.eventunimed.id>

# Log aktivitas di admin (Tahap 9): baca dari Analytics Engine lewat SQL API. Tanpa keduanya halaman Log menampilkan
# penjelasan (AE tidak tersedia di dev lokal). Token HARUS read-only (Account Analytics: Read).
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
